# Copy to .env and fill in. .env is gitignored; keys are never printed.

# ElevenLabs (paid TTS). https://elevenlabs.io -> Profile -> API keys
ELEVENLABS_API_KEY=

# Pexels (free stock photos/video). https://www.pexels.com/api/
PEXELS_API_KEY=

# Render server (Kokoro voice runs there over SSH; see CLAUDE.md "Kokoro voice"), e.g. root@203.0.113.10
RENDER_SERVER=
