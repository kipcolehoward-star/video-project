          {
            "name": "Canada",
            "cue": "canada",
            "label": "Canada"
          },
          {
            "name": "Mexico",
            "cue": "mexico",
            "label": "Mexico"
          },
          {
            "name": "Philippines",
            "cue": "philippines",
            "label": "Philippines"
          }
        ],
        "markers": [
