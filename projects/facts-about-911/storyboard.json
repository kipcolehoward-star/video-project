            "lon": -61.85,
            "lat": 17.12,
            "cue": "antigua",
            "labelSide": "right"
          }
        ]
      }
    },
    {
      "id": "s29-warning",
      "type": "title",
      "duration": 3,
      "narration": "But there's an important warning: Don't assume that 911 works everywhere just because it works in the United States. Emergency numbers vary dramatically around the world.",
      "data": {
        "kicker": "A warning",
        "title": "911 doesn't work everywhere.",
        "cue": "assume"
      }
    },
    {
